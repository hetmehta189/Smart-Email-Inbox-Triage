# =============================================
# Email Triage Agent — Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git!

# ── Gmail Account Labels ─────────────────────
# These labels appear in Slack notifications so you know
# which account received the email.
GMAIL_ACCOUNT_1_LABEL=your_first_email@gmail.com
GMAIL_ACCOUNT_2_LABEL=your_second_email@gmail.com

# ── Gemini API Key ────────────────────────────
# Get yours free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model ──────────────────────────────
# gemini-2.0-flash is fast and cheap. Change to experiment.
# Options: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ── Slack Incoming Webhook URL ────────────────
# How to get this:
#   1. Go to https://api.slack.com/apps → Create New App → From Scratch
#   2. Name it "Email Triage Agent" → select your workspace
#   3. Left sidebar → Incoming Webhooks → toggle ON
#   4. Click "Add New Webhook to Workspace" → choose a channel → Allow
#   5. Copy the Webhook URL and paste it below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxxxxxxxxxxx
